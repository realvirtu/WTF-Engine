import hxp.*;
import lime.tools.*;
import haxe.io.Bytes;

using StringTools;
using tools.AnsiTools;

/**
 * The engine"s project class.
 */
class Project extends HXProject
{
    //
    // PROJECT
    //

    static final TITLE:String = "Friday Night Funkin' WTF Engine";
    static final VERSION:String = "0.1.0";
    static final COMPANY:String = "Virtu";
    static final PACKAGE:String = "com.virtu.wtfengine";

    static final EXE_NAME:String = "WTFEngine";

    static final MAIN_CLASS:String = "Main";
    static final PRELOADER:String = "flixel.system.FlxPreloader";

    //
    // FLAGS
    //

    static final FEATURE_ANTI_MASH:FeatureFlag = "FEATURE_ANTI_MASH";
    static final FEATURE_DEBUG:FeatureFlag = "FEATURE_DEBUG";
    static final FEATURE_DISCORD_RPC:FeatureFlag = "FEATURE_DISCORD_RPC";
    static final FEATURE_FOCUS_LOST_VOLUME:FeatureFlag = "FEATURE_FOCUS_LOST_VOLUME";
    static final FEATURE_FPS_COUNTER:FeatureFlag = "FEATURE_FPS_COUNTER";
    static final FEATURE_MODDING:FeatureFlag = "FEATURE_MODDING";
    static final FEATURE_OLD_ICON_SECRET:FeatureFlag = "FEATURE_OLD_ICON_SECRET";
    static final FEATURE_SCREENSHOTS:FeatureFlag = "FEATURE_SCREENSHOTS";
    static final FEATURE_TRANS_SECRET:FeatureFlag = "FEATURE_TRANS_SECRET";

    public function new()
    {
        super();

        if (isWeb())
            error("Web isn't supported you stupid bitch.");

        setupBuildPath();
        setupFlags();

        if (!isBuild())
            return;

        meta.title = TITLE;
        meta.version = VERSION;
        meta.company = COMPANY;
        meta.packageName = PACKAGE;

        app.main = MAIN_CLASS;
        app.file = EXE_NAME;
        app.preloader = PRELOADER;

        window.width = 1280;
        window.height = 720;
        window.fps = 60;
        window.background = 0x000000;
        window.hardware = true;
        window.vsync = false;

        window.orientation = Orientation.LANDSCAPE;
        window.fullscreen = false;
        window.resizable = true;

        sources.push("source");
        icons.push(new Icon("art/icon.png"));

        preBuildCallbacks.push(CommandHelper.interpretHaxe('source/PreBuild.hx'));
        postBuildCallbacks.push(CommandHelper.interpretHaxe('source/PostBuild.hx'));
        
        includeAssets("assets");

        setupDefines();
        setupMacros();
        setupHaxelibs();
    }

    public function setupBuildPath()
    {
        var path:String = "release";

        if (isDebug())
            path = "debug";

        // Sets the export path
        // On debug, it"s "export/debug"
        // On release, it"s "export/release"
        app.path = 'export/$path';
    }

    public function setupFlags()
    {
        FEATURE_ANTI_MASH.apply(this, true);
        FEATURE_DEBUG.apply(this, false);
        FEATURE_DISCORD_RPC.apply(this, true);
        FEATURE_FOCUS_LOST_VOLUME.apply(this, true);
        FEATURE_FPS_COUNTER.apply(this, true);
        FEATURE_MODDING.apply(this, true);
        FEATURE_OLD_ICON_SECRET.apply(this, true);
        FEATURE_SCREENSHOTS.apply(this, true);
        FEATURE_TRANS_SECRET.apply(this, true);

        printFlags();
    }

    public function setupDefines()
    {
        //
        // WTF ENGINE
        //

        setHaxedef("funkin", VERSION);

        //
        // FLIXEL
        //

        setHaxedef("FLX_NO_HEALTH");
        setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");

        setHaxedef("NAPE_RELEASE_BUILD");

        if (FEATURE_DEBUG.isDisabled(this))
        {
            setHaxedef("FLX_NO_DEBUG");
            setHaxedef("analyzer-optimize");
        }

        //
        // POLYMOD
        //

        setHaxedef("POLYMOD_MOD_METADATA_FILE", "meta.json");
        setHaxedef("POLYMOD_MOD_ICON_FILE", "icon.png");

        if (FEATURE_DEBUG.isEnabled(this))
        {
            setHaxedef("POLYMOD_DEBUG");
            setHaxedef("hscriptPos");
        }

        //
        // MISC
        //

        setHaxedef("openfl-enable-handle-error");
        setHaxedef("openfl_pool_events");

        setHaxedef("lime_disable_assets_version");

        setHaxedef("HXCPP_CHECK_POINTER");
        setHaxedef("HXCPP_GC_GENERATIONAL");
        setHaxedef("HXCPP_STACK_LINE");
        setHaxedef("HXCPP_STACK_TRACE");
        
        // Makes message reporting nice and pretty
        // Remove this line if you're lame
        setHaxedef("message.reporting", "pretty");
    }

    public function setupMacros()
    {
        // Fixes some stupid dumb problems with Polymod
        // :whatthemad:
        addHaxeFlag("-dce no");

        // Include every flixel and funkin class
        // Though we're excluding ones that require extra dependencies
        addHaxeMacro("include('funkin', true)");
        addHaxeMacro("include('flixel', true, ['flixel.addons.editors.spine.*', 'flixel.addons.nape.*', 'flixel.system.macros.*', 'flixel.addons.tile.FlxRayCastTilemap'])");
    }

    public function setupHaxelibs()
    {
        addHaxelib("flixel");
        addHaxelib("flixel-addons");

        addHaxelib("funkin.vis");
        
        addHaxelib("polymod");
        addHaxelib("json2object");

        addHaxelib("hxdiscord_rpc");
    }

    public function setHaxedef(name:String, ?value:String)
    {
        haxedefs.set(name, value ?? "");
    }

    public function removeHaxedef(name:String)
    {
        haxedefs.remove(name);
    }

    public function addHaxelib(name:String)
    {
        haxelibs.push(new Haxelib(name));
    }

    public function addHaxeFlag(name:String)
    {
        haxeflags.push(name);
    }

    public function addHaxeMacro(name:String)
    {
        addHaxeFlag('--macro $name');
    }

    //
    // LOGGING
    //

    public function info(message:String)
    {
        if (!isBuild())
            return;
        Sys.println(message.info());
    }

    public function error(message:String)
    {
        if (!isBuild())
            return;
        Sys.stderr().write(Bytes.ofString(message.error()));
        Sys.exit(1);
    }

    public function printFlags()
    {
        if (!isBuild())
            return;

        info("");

        var enabled:Array<String> = [];
        var disabled:Array<String> = [];
        
        for (flag in haxedefs.keys())
        {
            if (!flag.startsWith(FeatureFlag.INVERSE_PREFIX))
                enabled.push(flag);
            else
                disabled.push(flag.substr(FeatureFlag.INVERSE_PREFIX.length));
        }

        enabled.sort((a, b) -> return a > b ? 1 : -1);
        disabled.sort((a, b) -> return a > b ? 1 : -1);

        if (enabled.length > 0)
        {
            info("Enabled Flags:");
            info("");

            for (flag in enabled)
                info('- $flag'.white());
        }

        info("");

        if (disabled.length > 0)
        {
            info("Disabled Flags:");
            info("");

            for (flag in disabled)
                info('- $flag'.white());
        }
    }

    //
    // CONDITIONALS
    //

    public function isWeb():Bool
    {
        return platformType == PlatformType.WEB;
    }

    public function isBuild():Bool
    {
        return command == "test" || command == "build";
    }

    public function isDebug():Bool
    {
        return debug;
    }
}

/**
 * Feature flag class to make flag stuff easier.
 * Kinda stolen from Funkin' lmao.
 */
abstract FeatureFlag(String) to String from String
{
    public static final INVERSE_PREFIX:String = 'NO_';

    public function new(name:String)
    {
        this = name;
    }

    public function apply(project:Project, enabled:Bool)
    {
        if (isEnabled(project))
            enable(project);
        else if (getInverse().isEnabled(project))
            disable(project);
        else
        {
            if (enabled)
                enable(project);
            else
                disable(project);
        }
    }

    public function enable(project:Project, checkInverse:Bool = true)
    {
        project.setHaxedef(this, '');

        if (checkInverse)
            getInverse().disable(project, false);
    }

    public function disable(project:Project, checkInverse:Bool = true)
    {
        project.removeHaxedef(this);

        if (checkInverse)
            getInverse().enable(project, false);
    }

    public function isEnabled(project:Project):Bool
    {
        return project.haxedefs.exists(this) || project.defines.exists(this);
    }

    public function isDisabled(project:Project):Bool
    {
        return getInverse().isEnabled(project);
    }

    public function getInverse():FeatureFlag
    {
        if (this.startsWith(INVERSE_PREFIX))
            return this.substr(INVERSE_PREFIX.length);
        return INVERSE_PREFIX + this;
    }
}