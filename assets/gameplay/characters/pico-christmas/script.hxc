import funkin.play.character.CharacterType;
import funkin.play.character.Character;
import funkin.play.GameOverSubState;
import funkin.play.PauseSubState;

class PicoChristmasCharacter extends Character
{
    public function new()
    {
        super('pico-christmas');
    }

    override function onCreate(event:ScriptEvent)
    {
        super.onCreate(event);

        if (type != CharacterType.PLAYER)
            return;

        GameOverSubState.deathId = 'pico';
        GameOverSubState.deathMusic = 'pico';
        GameOverSubState.deathSFX = 'pico';

        PauseSubState.musicId = 'pico';
    }
}