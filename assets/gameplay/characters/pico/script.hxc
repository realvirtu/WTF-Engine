import funkin.play.character.CharacterType;
import funkin.play.character.Character;
import funkin.play.GameOverSubState;

class PicoCharacter extends Character
{
    public function new()
    {
        super('pico');
    }

    override function onNoteHit(event:NoteScriptEvent)
    {
        super.onNoteHit(event);

        setDeath('pico');

        switch (event.note.kind)
        {
            case 'cock-gun':
                playAnimation('cock');
            case 'fire-gun':
                playAnimation('fire');
        }
    }

    override function onNoteMiss(event:NoteScriptEvent)
    {
        super.onNoteMiss(event);

        if (event.note.kind == 'fire-gun')
            setDeath('pico-explode');
    }

    override function onSongRetry(event:ScriptEvent)
    {
        super.onSongRetry(event);

        setDeath('pico');
    }

    function setDeath(id:String)
    {
        if (type != CharacterType.PLAYER)
            return;

        GameOverSubState.deathId = id;
        GameOverSubState.deathSFX = id;
        GameOverSubState.deathMusic = 'pico';
    }
}