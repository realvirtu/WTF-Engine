import funkin.audio.FunkinSound;
import funkin.play.song.Song;
import funkin.play.Playlist;
import funkin.play.PlayState;

class RosesSong extends Song
{
    var seenCutscene:Bool = false;

    public function new()
    {
        super('roses');
    }

    override function onCountdownStart(event:CountdownScriptEvent)
    {
        super.onCountdownStart(event);

        if (seenCutscene)
            return;
        seenCutscene = true;

        event.cancel();

        PlayState.instance.startConversation('roses', PlayState.instance.startCountdown);

        FunkinSound.playOnce(getPath('sounds/angry'));
    }

    override function onDestroy(event:ScriptEvent)
    {
        super.onDestroy(event);

        seenCutscene = false;
    }
}